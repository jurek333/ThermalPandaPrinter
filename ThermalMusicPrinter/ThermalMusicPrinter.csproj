<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ThermalMusicPrinter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AlphaTab" Version="1.9.0" />
    <PackageReference Include="AlphaSkia.Native.MacOs" Version="3.5.147" />
    <Content Include="BluetoothSender/Package.swift" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BluetoothSender/Sources/**/*.swift" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
